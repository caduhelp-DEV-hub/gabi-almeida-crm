# Supabase - chaves públicas (NEXT_PUBLIC_*) são expostas ao frontend.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Chave de service role (privada) - usada apenas no servidor Next.js.
# NUNCA exponha esta chave ao frontend.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Personal Access Token do Supabase (para Management API - aplicar schema via script).
# Obtenha em: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN="your-personal-access-token"

# Segredo do JWT usado pela autenticação customizada (lib/auth.ts).
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
JWT_SECRET="change-me-to-a-strong-random-secret"

# Segredo JWT do PROJETO SUPABASE (diferente do JWT_SECRET acima).
# Copie de: painel Supabase -> Settings -> API -> JWT Settings -> JWT Secret.
# Usado para assinar o token que o navegador apresenta ao banco, permitindo
# fechar o acesso público (ver lib/supabaseToken.ts).
# Enquanto estiver vazio, o app continua funcionando com a chave anon.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# GEMINI_API_KEY: Necessária para o assistente AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde a aplicação está hospedada.
APP_URL="MY_APP_URL"
